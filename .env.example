# Copy to .env and adjust. .env is gitignored; this file is the committed template.

# Used by docker-compose to create the local database
POSTGRES_USER=barpos
POSTGRES_PASSWORD=barpos_dev_password
POSTGRES_DB=barpos
POSTGRES_PORT=5433

# Used by the API and Drizzle to connect
DATABASE_URL=postgres://barpos:barpos_dev_password@localhost:5433/barpos
